# Copy to .env and fill in what you use. Nothing here is read at import time.

# --- Local runs: the team runner and the SDK agent ------------------------------------------------
# The external coding CLIs read their own keys from the environment.
ANTHROPIC_API_KEY=your_anthropic_api_key_here   # claude harness (Claude Code)
OPENAI_API_KEY=your_openai_api_key_here         # codex harness, and sdk@<openai model>

# Optional: any other provider through LiteLLM (sdk@litellm/<provider>/<model>);
# install with `uv sync --extra litellm`.
OPENROUTER_API_KEY=

# Optional: higher Hugging Face rate limits for the benchmark dataset download.
HF_TOKEN=

# --- Benchmark (`uv sync --extra bench`) ---------------------------------------------------------
# Sandboxes run on Modal. Authenticate once; the token is stored in ~/.modal.toml, not in this file:
#   uv run --extra bench modal token set --token-id ak-... --token-secret as-...
# (CI-style alternative: export MODAL_TOKEN_ID / MODAL_TOKEN_SECRET.)
#
# Agents inside the sandboxes get their API keys from a Modal Secret, never from this file.
# Create it once with the keys your teams need (name defaults to `multi-agents-bench`,
# override with --secret):
#   uv run --extra bench modal secret create multi-agents-bench \
#       ANTHROPIC_API_KEY=... OPENAI_API_KEY=... OPENROUTER_API_KEY=...
#
# Optional: Docker Hub credentials if image pulls are rate limited (--registry-secret):
#   uv run --extra bench modal secret create dockerhub \
#       REGISTRY_USERNAME=... REGISTRY_PASSWORD=...
